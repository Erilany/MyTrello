{
  "name": "c-projets",
  "version": "1.1.0",
  "description": "Application de gestion de projets à 3 niveaux avec intégration Outlook, Gmail et commandes vocales",
  "main": "electron.js",
  "scripts": {
    "dev": "npx vite",
    "electron:dev": "concurrently \"npx vite\" \"wait-on http://localhost:5175 && electron .\"",
    "electron": "electron .",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .js,.jsx",
    "lint:fix": "eslint src --ext .js,.jsx --fix",
    "format": "prettier --write \"src/**/*.{js,jsx}\""
  },
  "keywords": [
    "project-management",
    "trello-like",
    "electron",
    "react"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "dexie": "^4.4.2",
    "dompurify": "^3.4.4",
    "electron-store": "^8.1.0",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-quill": "^2.0.0",
    "react-router-dom": "^6.20.0",
    "sql.js": "^1.14.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.2",
    "@babel/traverse": "^7.29.0",
    "@babel/types": "^7.29.0",
    "@electron/rebuild": "^3.7.2",
    "@playwright/test": "^1.40.0",
    "@testing-library/react": "^14.1.2",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jest": "^29.7.0",
    "postcss": "^8.4.32",
    "prettier": "^3.1.1",
    "tailwindcss": "^3.4.0",
    "terser": "^5.47.1",
    "vite": "^5.4.21",
    "wait-on": "^7.2.0"
  }
}
